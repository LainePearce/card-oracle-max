[Unit]
Description=Card Oracle DINOv2 embed worker (GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/card-oracle-max
ExecStart=/home/ec2-user/card-oracle-max/.venv/bin/python -u tools/dino_embed_worker.py --batch 32 --loop
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target

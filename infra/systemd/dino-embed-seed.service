[Unit]
Description=Card Oracle DINOv2 embed seeder + stale reaper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/card-oracle-max
ExecStart=/home/ec2-user/card-oracle-max/.venv/bin/python tools/seed_dino_embed.py --start 2025-01-01 --reap-stale-minutes 30

[Unit]
Description=Card Oracle image-archive seeder + stale-worker reaper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/card-oracle-max
ExecStart=/home/ec2-user/card-oracle-max/.venv/bin/python tools/seed_image_archive.py --reap-stale-minutes 30

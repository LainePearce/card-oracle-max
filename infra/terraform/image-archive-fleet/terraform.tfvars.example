# --- image-archive CPU fleet ---
# Copy to terraform.tfvars and fill in. Two modes:
#
#   2025 historical drain:  worker_count = 6,  instance_type = "c7i.2xlarge"
#   in-service daily:       worker_count = 1,  instance_type = "c7i.xlarge"
#
# Switch modes by editing these two and re-running `terraform apply`.

aws_region    = "us-west-1"
key_pair_name = "qdrant-test"
my_ips        = ["153.53.225.179/32"]

# ASG desired size (= min). 6 for the 2025 drain; 1 for daily routine.
worker_count = 6

# The ASG diversifies across these spot pools for resilience; first is the LT default.
instance_types = ["c7i.2xlarge", "c6i.2xlarge", "m7i.2xlarge", "c7a.2xlarge", "m6i.2xlarge"]

# 0 = all spot (cheapest). Set 1 to keep one guaranteed on-demand anchor.
on_demand_base_capacity = 0

download_workers = 16

s3_vector_bucket = "card-oracle-vectors"
s3_image_bucket  = "images-130-sold"

opensearch_host     = "REPLACE-with-extant-os-host.us-west-1.es.amazonaws.com"
opensearch_user     = "REPLACE"
opensearch_password = "REPLACE"
